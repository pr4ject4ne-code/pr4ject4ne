# Secrets & local config — never commit real env files
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies & build output (extend when stack is chosen)
node_modules/
dist/
build/
.next/
next-env.d.ts
coverage/
*.tsbuildinfo
__pycache__/
*.pyc
.venv/
venv/

# Local uploaded media (dev only; keep the folder, ignore its contents)
uploads/*
!uploads/.gitkeep

# OS & editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Logs & temp
*.log
tmp/
.claude/scheduled_tasks.lock
