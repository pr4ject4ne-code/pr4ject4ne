# Racoon Eye — environment variables
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.

# --- Database (PostgreSQL, hosted on Neon) ---
# Full connection string used by src/lib/db.ts. Get this from the Neon dashboard
# (Connection Details → pooled connection string). Neon uses trusted CA certs
# (unlike Supabase's self-signed chain), so plain sslmode=require works — no
# uselibpqcompat workaround needed.
DATABASE_URL=postgresql://user:password@ep-example-12345.region.aws.neon.tech/dbname?sslmode=require

# --- Session / auth ---
# Sessions are DB-backed random tokens (hashed at rest) — no signing secret is
# required, so none is configured here. If a signed-cookie/HMAC scheme is added
# later, introduce a SESSION_SECRET at that point.
#
# Node environment. In production this MUST be "production" so secure cookies are enforced.
NODE_ENV=development

# Trust x-forwarded-for / x-real-ip headers for client-IP extraction (audit logs,
# per-IP rate limiting). Set to "true" ONLY when deployed behind a trusted
# proxy/load balancer that overwrites these headers; otherwise clients can spoof
# their IP. Default (unset/false): forwarded headers are ignored and the IP is
# recorded as null / bucketed as 'unknown'.
TRUST_PROXY_HEADERS=false

# --- Two-factor authentication for primary admin/developer accounts ---
# AES-256-GCM key used to encrypt/decrypt `users.totp_secret_encrypted` (the
# TOTP shared secret is never stored in plaintext). Any string works — it is
# fed through SHA-256 to derive the actual 32-byte key, so length doesn't
# matter, but it MUST be a real, high-entropy secret in production (e.g.
# `openssl rand -hex 32`), generated ONCE and kept only in the platform secret
# store. Rotating this key invalidates every existing TOTP enrollment (the old
# secrets can no longer be decrypted) — accepted tradeoff, simpler than
# re-encrypting on rotation; affected admins just re-enroll via /dev/primary
# (or another primary uses the `reset_totp` action / `db:reset-admin-totp`
# script to clear a locked-out account's enrollment). Required only once a
# primary account actually enables 2FA (self-serve opt-in — see migration 021).
TOTP_ENCRYPTION_KEY=

# --- Bootstrap the first primary developer (used ONLY by `npm run db:bootstrap-admin`) ---
# One-off: creates/promotes the level-1 primary account so /dev/primary is reachable
# on a fresh database. The password policy is not enforced here — rotate it in-app
# after first login. Do not keep these set in a real environment.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- External services ---
# Public OSRM demo server for routing/ETA (no key required). Self-host later if needed.
NEXT_PUBLIC_OSRM_URL=https://router.project-osrm.org

# --- Basemap (MapTiler vector tiles via MapLibre GL) ---
# NEXT_PUBLIC_* = shipped to the browser by design (the map renders client-side),
# so this key is NOT a secret. Protect it by restricting Allowed origins to your
# domain(s) in the MapTiler dashboard. Free tier: 100k map loads/month, no card.
# When unset, the map falls back to raster OpenStreetMap tiles (no vector polish).
# Also powers the manual-location geocoding fallback when geolocation is denied.
NEXT_PUBLIC_MAPTILER_KEY=
# Basemap style id (streets-v2, streets-v2-light, dataviz-light, basic-v2, …).
NEXT_PUBLIC_MAP_STYLE=streets-v2

# --- Email delivery (Resend, worklist #18/#19: confirmation + welcome + password reset) ---
# Chosen for its no-card-required free tier (3k emails/mo) — consistent with this
# project's standing pattern of avoiding services with billing-signup friction
# (same reasoning that picked MapTiler/OSRM/Leaflet over Mapbox/ORS, and kept
# Supabase Storage over Cloudflare R2). Get a key at https://resend.com after
# verifying a sending domain (or use their onboarding@resend.dev test sender).
# OPTIONAL in dev: when unset, src/lib/email.ts logs a structured warning with
# what WOULD have been sent (recipient/subject/truncated preview) instead of
# throwing — signup still succeeds, it just won't actually deliver an email.
RESEND_API_KEY=
# "Display Name <address@yourdomain>" the confirmation/welcome emails are sent
# from. Defaults to Resend's shared test sender if unset (fine for dev, not for
# production — verify your own domain in the Resend dashboard first).
RESEND_FROM_EMAIL=Racoon Eye <onboarding@resend.dev>
# Absolute base URL used to build links inside emails (e.g. the email-confirmation
# link). Must be the real public URL in production (e.g. https://pr4ject4ne.vercel.app).
SITE_URL=http://localhost:3000

# --- Image uploads (Supabase Storage) ---
# Used by /api/uploads for hospital photos/logos and first-aid images. Find these
# in the Supabase dashboard → Project Settings → API. The service-role key is a
# SECRET (server-side only, bypasses RLS) — never expose it to the client.
# When unset, uploads degrade gracefully: the endpoint returns 503 and the UI still
# accepts image URLs. The bucket must exist and be public for read access.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media
