# Racoon Eye — environment variables
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.

# --- Database (PostgreSQL) ---
# Full connection string used by src/lib/db.ts.
DATABASE_URL=postgres://racoon:racoon_dev_password@localhost:5432/racoon_eye

# --- Session / auth ---
# Sessions are DB-backed random tokens (hashed at rest) — no signing secret is
# required, so none is configured here. If a signed-cookie/HMAC scheme is added
# later, introduce a SESSION_SECRET at that point.
#
# Node environment. In production this MUST be "production" so secure cookies are enforced.
NODE_ENV=development

# --- Suggestions / feedback routing (server-side only, never exposed to the client) ---
# All "suggestion tab" submissions are routed to this address.
SUGGESTIONS_EMAIL=pr4ject4ne@gmail.com

# --- External services ---
# Public OSRM demo server for routing/ETA (no key required). Self-host later if needed.
NEXT_PUBLIC_OSRM_URL=https://router.project-osrm.org

# OpenStreetMap tile server template used by Leaflet.
NEXT_PUBLIC_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# --- Local file storage (DEV ONLY) ---
# TODO: replace with S3/server object storage when infrastructure is ready.
UPLOAD_DIR=./uploads
